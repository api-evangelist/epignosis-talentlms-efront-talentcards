{
  "opencollection": "1.0.0",
  "info": {
    "name": "Efront Account Catalog API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Catalog",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /User/{Id}/Catalog/",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://virtserver.swaggerhub.com/Epignosis/Efront-API/1.0.0/User/:Id/Catalog/",
            "params": [
              {
                "name": "Id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the course catalog list for a given user."
        }
      ]
    }
  ],
  "bundled": true
}