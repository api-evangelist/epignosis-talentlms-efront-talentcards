{
  "opencollection": "1.0.0",
  "info": {
    "name": "Efront Account Category API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Category",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /Category/{Id}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://virtserver.swaggerhub.com/Epignosis/Efront-API/1.0.0/Category/:Id",
            "params": [
              {
                "name": "Id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns information about the category with the associated Id."
        },
        {
          "info": {
            "name": "GET /Categories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://virtserver.swaggerhub.com/Epignosis/Efront-API/1.0.0/Categories"
          },
          "docs": "Returns the category list (tree structured)."
        }
      ]
    }
  ],
  "bundled": true
}